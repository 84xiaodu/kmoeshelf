# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KMOE_APP_SECRET_KEY=replace-with-at-least-32-random-characters
KMOE_STORAGE_HOST_ROOT=./downloads
KMOE_DATABASE_URL=sqlite+aiosqlite:////data/app.db
KMOE_DOWNLOAD_DIR=/storage
KMOE_COOKIE_SECURE=false
# Optional: enrich recommendations by sending subscribed comic titles to Bangumi's public API.
KMOE_BANGUMI_RECOMMENDATIONS=false
KMOE_BANGUMI_API_BASE_URL=https://api.bgm.tv
